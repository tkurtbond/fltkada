

with

    "fltkada",
    "proj/common";


project Tests is


    for Languages use ("Ada");

    for Source_Dirs use ("test");
    for Object_Dir  use "obj";
    for Exec_Dir    use "bin";

    for Main use
       ("adjuster.adb",
        "ask.adb",
        "bitmap.adb",
        "button.adb",
        "buttons.adb",
        "clear_image_chosen.adb",
        "compare.adb",
        "clock.adb",
        "color_chooser.adb",
        "column_widths.adb",
        "cursor.adb",
        "dirlist.adb",
        "filename.adb",
        "group_children.adb",
        "hello.adb",
        "page_formats.adb",
        "pixmap.adb",
        "preferences.adb",
        "tree.adb",
        "tree_table1.adb",
        "tree_simple.adb",
        "tree_as_container.adb",
        "tree_custom_sort.adb",
        "tree_of_tables.adb");

    package Builder is
        for Executable ("adjuster.adb")           use "adjuster";
        for Executable ("ask.adb")                use "ask";
        for Executable ("bitmap.adb")             use "bitmap";
        for Executable ("button.adb")             use "button";
        for Executable ("buttons.adb")            use "buttons";
        for Executable ("clear_image_chosen.adb") use "clear_image_chosen";
        for Executable ("compare.adb")            use "compare";
        for Executable ("clock.adb")              use "clock";
        for Executable ("color_chooser.adb")      use "color_chooser";
        for Executable ("column_widths.adb")      use "column_widths";
        for Executable ("cursor.adb")             use "cursor";
        for Executable ("dirlist.adb")            use "dirlist";
        for Executable ("filename.adb")           use "filename";
        for Executable ("group_children.adb")     use "group_children";
        for Executable ("hello.adb")              use "hello";
        for Executable ("page_formats.adb")       use "page_formats";
        for Executable ("pixmap.adb")             use "pixmap";
        for Executable ("preferences.adb")        use "preferences";
        for Executable ("tree.adb")               use "tree";
        for Executable ("tree_table1.adb")        use "tree_table1";
        for Executable ("tree_simple.adb")        use "tree_simple";
        for Executable ("tree_as_container.adb")  use "tree_as_container";
        for Executable ("tree_custom_sort.adb")   use "tree_custom_sort";
        for Executable ("tree_of_tables.adb")     use "tree_of_tables";

        for Default_Switches ("Ada") use
            Common.Builder'Default_Switches ("Ada");
        for Global_Compilation_Switches ("Ada") use
            Common.Builder'Global_Compilation_Switches ("Ada");
    end Builder;

    package Compiler       renames Common.Compiler;
    package Binder         renames Common.Binder;
    package Linker         renames Common.Linker;
    package Pretty_Printer renames Common.Pretty_Printer;


end Tests;


