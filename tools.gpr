

with

    "proj/common";


project Tools is


    for Languages use ("Ada");

    for Source_Dirs use ("tool");
    for Object_Dir use "obj";
    for Exec_Dir use "bin";

    for Main use ("template.adb");

    package Builder is
        for Executable ("template.adb") use "template";
    end Builder;

    package Compiler renames Common.Compiler;


end Tools;


