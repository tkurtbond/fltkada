

with

    "fltkada",
    "shared";


project Compare is


    for Languages use ("Ada");

    for Source_Dirs use ("../test/**");
    for Object_Dir use "../obj";
    for Exec_Dir use "../bin";
    for Main use ("compare.adb");

    package Builder is
        for Executable ("compare.adb") use "compare";
    end Builder;

    package Compiler renames Shared.Compiler;


end Compare;


