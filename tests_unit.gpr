--  The unit tests in test/unit: each test_<area>.adb checks its own
--  results, prints ok/FAIL/skip lines and sets the exit status.  make
--  check runs them (PLAN.md, Phase 0).  FLTK.Probe and its C++ part are
--  compiled here, not in the library.  Assertions are always on (-gnata),
--  so predicates and Pre in the library's specs are checked in the test
--  code that calls them.


with

    "fltkada",
    "proj/common";


project Tests_Unit is


    for Languages use ("Ada", "C++");

    for Source_Dirs use ("test/unit");
    for Object_Dir  use "obj/unit";
    for Exec_Dir    use "bin/unit";

    for Main use
       ("test_constants.adb",
        "test_utf8.adb",
        "test_offscreens.adb",
        "test_probe.adb",
        "test_kept_strings.adb",
        "test_font_kinds.adb",
        "test_menu_labels.adb",
        "test_chooser_labels.adb",
        "test_printer_labels.adb",
        "test_glut_strings.adb",
        "test_glut_live.adb",
        "test_group_clear.adb",
        "test_grid_range.adb",
        "test_text_search.adb",
        "test_numeric_sort.adb",
        "test_image_crafted.adb",
        "test_image_names.adb",
        "test_filenames.adb",
        "test_free_font.adb",
        "test_dashes.adb",
        "test_terminal_fit.adb",
        "test_ps_errors.adb",
        "test_page_misuse.adb",
        "test_image_reentry.adb",
        "test_gl_text_width.adb",
        "test_chart_labels.adb",
        "test_read_outside.adb",
        "test_clip_box.adb",
        "test_defined_types.adb",
        "test_menu_chosen.adb",
        "test_browser_top.adb",
        "test_pnm_maxval.adb",
        "test_parse_args.adb",
        "test_chart_maxsize.adb",
        "test_anim_copy.adb",
        "test_clock_time.adb",
        "test_shared_reload.adb",
        "test_filename_relative.adb",
        "test_window_label.adb",
        "test_spinner_colors.adb",
        "test_restore_clip.adb",
        "test_svg_support.adb",
        "test_print_support.adb",
        "test_cairo_support.adb",
        "test_help_dialog_group.adb",
        "test_changed_callback.adb",
        "test_browser_load.adb",
        "test_xpm_color_names.adb",
        "test_selection_buffer.adb",
        "test_menu_add_merge.adb",
        "test_gl_window_group.adb",
        "test_menu_add_items.adb",
        "test_spinner_format.adb",
        "test_menu_items.adb",
        "test_clipboard_kinds.adb",
        "test_font_sizes.adb",
        "test_image_lines.adb",
        "test_expand_text.adb",
        "test_recode.adb",
        "test_part_callbacks.adb",
        "test_statics_core.adb",
        "test_fatal_handler.adb",
        "test_draw_shapes.adb",
        "test_widget_trackers.adb",
        "test_paste_image.adb",
        "test_help_links.adb",
        "test_help_held.adb",
        "test_chooser_close.adb",
        "test_chooser_extra.adb",
        "test_table_children.adb",
        "test_buffer_life.adb",
        "test_browser_icons.adb",
        "test_exceptions.adb",
        "test_first_calls.adb",
        "test_wrong_state.adb",
        "test_print_font.adb",
        "test_popup_early.adb",
        "test_menu_global.adb",
        "test_highlight_data.adb",
        "test_tree_remove.adb",
        "test_tree_widgets.adb",
        "test_tree_icons.adb",
        "test_pref_groups.adb",
        "test_menu_item_labels.adb",
        "test_window_shape.adb",
        "test_image_data.adb",
        "test_write_png.adb",
        "test_shortcut_button.adb",
        "test_ico_image.adb",
        "test_image_handlers.adb",
        "test_widget_multi_label.adb",
        "test_file_icons.adb",
        "test_anim_canvas.adb",
        "test_tiled_tile.adb",
        "test_page_finalize.adb",
        "test_eps_surface.adb",
        "test_svg_surface.adb",
        "test_pdf_surface.adb");

    package Builder is
        for Default_Switches ("Ada") use
            Common.Builder'Default_Switches ("Ada");
        for Global_Compilation_Switches ("Ada") use
            Common.Builder'Global_Compilation_Switches ("Ada");
    end Builder;

    package Compiler is
        for Default_Switches ("Ada") use
            Common.Compiler'Default_Switches ("Ada") & "-gnata";
        for Default_Switches ("C++") use
            Common.Compiler'Default_Switches ("C++");
    end Compiler;

    package Binder         renames Common.Binder;
    package Linker         renames Common.Linker;
    package Pretty_Printer renames Common.Pretty_Printer;


end Tests_Unit;

