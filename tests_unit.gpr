--  The unit tests in test/unit: each test_<area>.adb checks its own
--  results, prints ok/FAIL/skip lines and sets the exit status.  make
--  check runs them (PLAN.md, Phase 0).  FLTK.Probe and its C++ part are
--  compiled here, not in the library.  Assertions are always on (-gnata),
--  so predicates and Pre in the library's specs are checked in the test
--  code that calls them.


with

    "fltkada",
    "proj/common";


project Tests_Unit is


    for Languages use ("Ada", "C++");

    for Source_Dirs use ("test/unit");
    for Object_Dir  use "obj/unit";
    for Exec_Dir    use "bin/unit";

