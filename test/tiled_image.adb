        "%%;$-%%+$$-%+$,.+;&)'%;.!#,%%%++,%$%';,$%%.+%,#+&+" &
         "'&$,,+*%+%%..+;#.+#$%+.+.,+;%$.%+*$++,.%++#@#$'$.!",
        ".&=$+&&%,%#%*,;*;*=&'$;+.##,,+.$+,*-'%%+,;.;$'%%,," &
         "'%,%*$%%%,,..;;..,+.+,%+,+,,*,#+&%%#.#.!.;@!%%...%",
        "%-$+'%.$-+%%%&%$-**=&$%%.;%+#.;$%.$;+%,%,;;%;*$%;=" &
         ".+,$--&$,+$&..#+%,%,$!+%++,+.%+%%$+%!#!##+++*$,@!#",
        ".#+=+@#&$-*,..'-*;-$$;$=';,++#@%%$+@+%%%$$,+&&+;$#" &
         ",;&===*;%*,=,#+##%).*%>#%+$#,*=.+%$+.$#.$+@%;*%+#.",
        "#$&+.$;%%-&;.;&;-;$$=$*-$,.,;;.#!.,.,$%,,,%&*;%;.." &
         ";'=$+$;;)%=,%+..%+#,,%&$+#,.;$$.,+#;#+,$%##;;;%&+;",
        ";+.>.;&%=+*,+&,%;*;%%'-$++%.%,.%%+&$;%%,%.%=.=*%%*" &
         "*)=)&%.#'-&,+%%#;;+>.$,+.*%#+!,,&,@;,,,.@=%&';,+.,");


    Count : Natural;

begin

    --  Fl::args with a handler, as the C++ calls it, stops at an argument
    --  it doesn't know, and says nothing.
    begin
        FLTK.Static.Parse_Args (Count);
    exception
        when FLTK.Static.Argument_Error =>
            null;
    end;

    FLTK.Screen.Set_Visual_Mode (FLTK.Screen.RGB);

    declare

        W     : Dbl.Double_Window := Dbl.Forge.Create (400, 400);
        Group : Grp.Group := Grp.Forge.Create (W, 0, 0, 400, 400);
        Pxm   : Pix.Pixmap := Pix.Forge.Create (Tile_Header, Tile_Colors, To_Data (Tile_Rows));
        Tile  : Tl.Tiled_Image := Tl.Forge.Create (Pxm);
        B     : Btn.Button := Btn.Forge.Create (Group, 340, 365, 50, 25, "Close");


        procedure Button_CB
               (Item : in out FLTK.Widgets.Widget'Class)
        is
            pragma Unreferenced (Item);
        begin
            W.Hide;
        end Button_CB;

    begin

        Group.Set_Image (Tile);
        Group.Set_Alignment (FLTK.Align_Inside);

        B.Set_Callback (Button_CB'Unrestricted_Access);

        Group.End_Current;

        W.Set_Resizable (Group);
        W.End_Current;
        W.Show_With_Args;

        return FLTK.Run;

    end;

end Tiled_Image;
