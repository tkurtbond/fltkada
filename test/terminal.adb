    F_SETFL    : constant := 4;
    O_NONBLOCK : constant := 8#4000#;
    EAGAIN     : constant := 11;


    --  Runs Text in a pipe, its output appended to the terminal
    procedure Do_Command
           (Text : in String)
    is
        use Interfaces.C.Strings;
        C_Text : chars_ptr := New_String (Text);
        C_Mode : chars_ptr := New_String ("r");
        Stream : constant Interfaces.C_Streams.FILEs := Popen (C_Text, C_Mode);
        Buffer : String (1 .. 4096);
        Count  : Integer;
    begin
        Free (C_Text);
        Free (C_Mode);
        New_Line_If_Floating;
        if Stream = Interfaces.C_Streams.NULL_Stream then
            TTY.Append_UTF8 (ESC & "[0;31mCan't execute '" &
                Text (Text'First .. Integer'Min (Text'Last, Text'First + 199)) & "': " &
                OS.Errno_Message & ESC & "[0m" & LF);
            return;
        end if;
        declare
            FD : constant Interfaces.C.int :=
                Interfaces.C.int (Interfaces.C_Streams.fileno (Stream));
            Unused : constant Interfaces.C.int := Fcntl (FD, F_SETFL, O_NONBLOCK);
            pragma Unreferenced (Unused);
        begin
            --  Non-blocking IO keeps the interface alive during slow commands
            loop
                declare
                    Waited : constant Long_Float := FLTK.Wait (0.05);
                    pragma Unreferenced (Waited);
                begin
                    Count := OS.Read (OS.File_Descriptor (FD), Buffer'Address, Buffer'Length);
                end;
                if Count = -1 and then OS.Errno = EAGAIN then
                    null;  --  no data yet
                elsif Count > 0 then
                    TTY.Append (Buffer (1 .. Count));  --  handles UTF-8
                else
                    exit;  --  pipe closed
                end if;
            end loop;
        end;
        declare
            Status : constant Interfaces.C.int := Pclose (Stream);
            pragma Unreferenced (Status);
        begin
            null;
        end;
        TTY.Append_ASCII (ESC & "[33;2m<<END_OF_OUTPUT>>" & ESC & "[0m" & LF);
        TTY.Redraw;
    end Do_Command;


    --  The controls  --

    --  sscanf's "%d" or "%lx" from Text (From): skips white space, takes a
    --  sign and, in Base 16, "0x", and at least one digit.  Value is the
    --  result mod 2**32, Fl_Color's size.
    procedure Scan_Number
           (Text  : in     String;
            From  : in out Positive;
            Base  : in     Positive;
            Value :    out Long_Long_Integer;
            Found :    out Boolean)
    is
        Negative : Boolean := False;
        Digit    : Integer;
    begin
        Value := 0;
        Found := False;
        while From <= Text'Last and then Text (From) in ' ' | ASCII.HT .. ASCII.CR loop
            From := From + 1;
        end loop;
        if From <= Text'Last and then Text (From) in '+' | '-' then
            Negative := Text (From) = '-';
            From := From + 1;
        end if;
        if Base = 16 and then From + 1 <= Text'Last and then Text (From) = '0'
            and then Text (From + 1) in 'x' | 'X'
        then
            From := From + 2;
            Found := True;  --  the 0
        end if;
        loop
            exit when From > Text'Last;
            case Text (From) is
                when '0' .. '9' => Digit := Character'Pos (Text (From)) - Character'Pos ('0');
                when 'a' .. 'f' => Digit := Character'Pos (Text (From)) - Character'Pos ('a') + 10;
                when 'A' .. 'F' => Digit := Character'Pos (Text (From)) - Character'Pos ('A') + 10;
                when others => exit;
            end case;
            exit when Digit >= Base;
            Value := (Value * Long_Long_Integer (Base) + Long_Long_Integer (Digit)) mod 2**32;
            Found := True;
            From := From + 1;
        end loop;
        if Negative then
            Value := (2**32 - Value) mod 2**32;
        end if;
    end Scan_Number;


    --  A colour from Text, decimal or "#" and hex, or an alert
    procedure Parse_Color
           (Text   : in     String;
            Result :    out FLTK.Color;
            Parsed :    out Boolean)
    is
        From  : Positive := Text'First;
        Value : Long_Long_Integer;
    begin
        if Text'Length > 0 and then Text (Text'First) = '#' then
            From := From + 1;
            Scan_Number (Text, From, 16, Value, Parsed);
        else
            Scan_Number (Text, From, 10, Value, Parsed);
        end if;
        Result := FLTK.Color (Value);
        if not Parsed then
            FLTK.Asks.Alert ("Illegal color value '" & Text & "'" & LF &
                "(can be e.g. '12' or '#0c', etc)");
        end if;
    end Parse_Color;


