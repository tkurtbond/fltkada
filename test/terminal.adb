    Set_Spinner (Font_Size, "", Font_Size_CB'Unrestricted_Access);
    Set_Spinner (Scrollbar_Size, "Size of scrollbar width in pixels",
        Scrollbar_Size_CB'Unrestricted_Access);
    Set_Spinner (Redraw_Rate, "Minimum time between redraws" & LF & "Default is 0.10 secs.",
        Redraw_Rate_CB'Unrestricted_Access);
    Redraw_Rate.Set_Kind (Spn.Float_Spin);
    Redraw_Rate.Set_Minimum (0.05);
    Redraw_Rate.Set_Maximum (5.0);
    Redraw_Rate.Set_Step (0.1);

    Scheme.Set_Tooltip ("Scheme");
    Scheme.Set_Box (FLTK.Up_Box);
    Scheme.Set_Down_Box (FLTK.Border_Box);
    Scheme.Set_Background_Color (FLTK.Background_Color);
    Scheme.Set_Selection_Color (FLTK.Selection_Color);
    Scheme.Set_Label_Size (10);
    Scheme.Set_Text_Size (10);
    Scheme.Set_Alignment (FLTK.Align_Left);
    Scheme.Set_When (FLTK.When_Release);

    Box_Choice.Set_Tooltip ("The border box for the Fl_Terminal");
    Box_Choice.Set_Down_Box (FLTK.Border_Box);
    Box_Choice.Set_Label_Size (10);
    Box_Choice.Set_Text_Size (10);
    for I in Box_Kinds'Range loop
        declare
            Place : constant FLTK.Widgets.Menus.Index := Box_Choice.Add
               (Box_Names (I).all, Box_CB'Unrestricted_Access,
                Flags => (if I = 7 then FLTK.Flag_Divider else FLTK.Flag_Normal));
        begin
            Box_Choice.Item (Place).Data.Set_Label_Size (8);
        end;
    end loop;

    Margins_Label.Set_Label_Size (10);
    Margins.Set_Label_Size (10);
    Margins.Set_Text_Size (10);
    Margins.Set_Callback (Margins_CB'Unrestricted_Access);
    Margins.Set_When (Input_When);

    Set_Check (LF_To_CRLF, "Line-feed (\n) performs carriage-return and line-feed (CRLF)",
        Output_Translate_CB'Unrestricted_Access);
    Set_Check (LF_To_CR, "Line-feed (\n) performs carriage-return (\r)",
        Output_Translate_CB'Unrestricted_Access);
    Set_Check (CR_To_LF, "Carriage-return (\r) performs line-feed (\n)",
        Output_Translate_CB'Unrestricted_Access);
    Set_Check (Show_Unknown,
        "Shows  unknown escape sequences/unprintable chars as ""¿"" character",
        Show_Unknown_CB'Unrestricted_Access);
    Set_Check (Interactive,
        "Allow Up/Dn/Lt/Rt keys to move cursor" & LF & "when terminal has focus",
        Interactive_CB'Unrestricted_Access);
    Set_Check (ANSI, "Handle ANSI/xterm escape sequences", ANSI_CB'Unrestricted_Access);
    Set_Check (Stdout, "Also send test output to stdout", null);

    Set_Color_Input (Text_Color,
        "The widget's text color. Has the effect of simultaneously setting:" & LF &
        "> textfgcolor()" & LF & ">textfgcolor_default()" & LF & Can_Be);
    Set_Color_Input (Text_Fg, "The text foreground color." & LF & Can_Be);
    Set_Color_Input (Text_Fg_Default, "The text foreground default color." & LF & Can_Be);
    Set_Color_Input (Cursor_Fg, "Foreground color for text under the cursor.");
    Set_Color_Input (Selection_Fg, "The mouse selection foreground color." & LF & Can_Be);
    Set_Color_Input (Color, "The widget's background color()." & LF & Can_Be);
    Set_Color_Input (Text_Bg, "The text background color." & LF &
        "Refer to the docs for the special value 0xffffffff." & LF & Can_Be);
    Set_Color_Input (Text_Bg_Default, "The text background default color." & LF &
        "Refer to the docs for the special value 0xffffffff." & LF & Can_Be);
    Set_Color_Input (Cursor_Bg,
        "Background color for the cursor." & LF & "This is the cursor block's color");
    Set_Color_Input (Selection_Bg, "The mouse selection background color." & LF & Can_Be);

    Terminal_Color.Set_Tooltip
       ("The (XTERM) colors can be influenced by Dim/Bold, whereas the (RGB) colors are not.");
    Terminal_Color.Set_Down_Box (FLTK.Border_Box);
    Terminal_Color.Set_Label_Size (9);
    Terminal_Color.Set_Text_Size (9);
    for I in Terminal_Colors'Range loop
        declare
            Place : constant FLTK.Widgets.Menus.Index := Terminal_Color.Add
               (Terminal_Colors (I).all, Terminal_Color_CB'Unrestricted_Access,
                Flags => (if I = 2 then FLTK.Flag_Divider else FLTK.Flag_Normal));
        begin
            Terminal_Color.Item (Place).Data.Set_Label_Size (9);
        end;
    end loop;
    Terminal_Color.Set_Chosen (1);

    Ops.Set_Box (FLTK.Engraved_Frame);
    Ops.Set_Label_Size (11);
    Set_Button (Reset_API, "Reset terminal using reset_terminal()" & LF &
        "Clears: screen, history, sets default tabstops, etc.", 8,
        Reset_API_CB'Unrestricted_Access);
    Set_Button (Reset_ANSI, "Reset terminal using ESC[c" & LF &
        "Clears: screen, history, sets default tabstops, etc.", 8,
        Reset_ANSI_CB'Unrestricted_Access);
    Set_Button (Home_API, "Moves cursor to home position (top/left) using cursor_home()", 8,
        Home_API_CB'Unrestricted_Access);
    Set_Button (Home_ANSI, "Moves cursor to home position (top/left) using ESC[H", 8,
        Home_ANSI_CB'Unrestricted_Access);
    Set_Button (History_API, "Clear scrollback history using clear_history()", 8,
        History_API_CB'Unrestricted_Access);
    Set_Button (History_ANSI, "Clear scrollback history using ESC[3J", 8,
        History_ANSI_CB'Unrestricted_Access);
    Set_Button (Screen_API, "Clear terminal screen using clear()." & LF &
        "Moves what was on the screen to the scroll history.", 8,
        Screen_API_CB'Unrestricted_Access);
    Set_Button (Screen_ANSI, "Clear terminal screen using ESC[H + ESC[2J" & LF &
        "Moves what was on the screen to the scroll history.", 8,
        Screen_ANSI_CB'Unrestricted_Access);
    To_Color_Group.Set_Box (FLTK.Flat_Box);
    To_Color_Group.Set_Background_Color (FLTK.Dark2_Color);
    Set_Button (To_Color, "Clear terminal screen to specific color" & LF &
        "Moves what was on the screen to the scroll history.", 8,
        To_Color_CB'Unrestricted_Access);
    Clear_Color.Set_Tooltip ("The color used by ""Clear Screen To Color"" button" & LF &
        "Can be decimal (e.g. 12) or hex (e.g. #0c, #ff000000, etc)");
    Clear_Color.Set_Label_Size (9);
    Clear_Color.Set_Text_Font (FLTK.Courier);
    Clear_Color.Set_Text_Size (9);
    Clear_Color.Set_When (Input_When);
    Clear_Color.Set_Value ("#ff000000");
    Set_Button (Speed, "Runs a full screen random chars/colors" & LF & "Shortcut: S", 11,
        Speed_CB'Unrestricted_Access);
    Speed.Set_Shortcut (FLTK.Press ('s'));
    Set_Button (Ring, "Show the Fl_Terminal raw ring buffer contents." & LF &
        "(Warning: This slows the UI and uses continuous cpu until closed)", 11,
        Ring_CB'Unrestricted_Access);

    Tests.Set_Box (FLTK.Engraved_Frame);
    Tests.Set_Label_Size (11);
    Set_Button (Unicode, "Show a Unicode screen alignment test" & LF &
        "Checks that troublesome Unicode chars don't cause misalignment", 9,
        Unicode_CB'Unrestricted_Access);
    Set_Button (Fifty, "Add 50 lines of text to terminal." & LF &
        "Tests screen history, scrollup", 9, Fifty_CB'Unrestricted_Access);
    Set_Button (Color_Bars, "Show colorbar test" & LF & "Tests API for setting colors" & LF &
        "Does *NOT* use ESC codes", 11, Color_Bars_CB'Unrestricted_Access);
    Self_Tests.Set_Label_Size (10);
    Set_Button (Previous, "Reverse through the ESC code self tests" & LF & "Shortcut: SHIFT+E",
        11, Previous_CB'Unrestricted_Access);
    Previous.Set_Shortcut (FLTK.Mod_Shift + 'e');
    Set_Button (Next, "Advance through the ESC code self tests" & LF & "Shortcut: 'e'", 11,
        Next_CB'Unrestricted_Access);
    Next.Set_Shortcut (FLTK.Press ('e'));

    Show_File.Set_Tooltip ("Type in the pathname of a file to cat to the screen");
    Show_File.Set_Label_Size (12);
    Show_File.Set_Text_Font (FLTK.Courier);
    Show_File.Set_Callback (Show_File_Or_Command'Unrestricted_Access);
    Show_File.Set_When (FLTK.When_Enter_Key_Always);
    Command.Set_Tooltip ("Command to run." & LF & "Hit ENTER to run command." & LF &
        "The command's stdout will appear in terminal.");
    Command.Set_Label_Size (12);
    Command.Set_Text_Font (FLTK.Courier);
    Command.Set_Callback (Show_File_Or_Command'Unrestricted_Access);
    Command.Set_When (FLTK.When_Release + FLTK.When_Enter_Key);

    TTY.Set_Box (FLTK.Down_Box);
    TTY.Set_Background_Color (FLTK.Foreground_Color);
    TTY.Set_Selection_Color (FLTK.Background_Color);
    TTY.Set_Label_Size (14);
    TTY.Set_Alignment (FLTK.Align_Top);
    TTY.Set_When (FLTK.When_Release);

    Win.Set_Size_Range (897, 330);

    TTY.Set_Background_Color (16#30200000#);  --  dark orange (makes true black easy to see)
    TTY.Set_Text_Size (12);                   --  smaller text (RGB demo needs this)
    Win.Set_Resizable (TTY);
    Command.Set_When (FLTK.When_Enter_Key_Always);
    declare
        Took : constant Boolean := Command.Take_Focus;  --  command prompt has focus on startup
        pragma Unreferenced (Took);
    begin
        null;
    end;
    Show_File.Set_Value ("/etc/login.defs");
    Command.Set_Value ("ls -la --color && ping google.com -c 5");

    --  Sync the inputs with the terminal's values
    Update_Inputs;

    --  The ring buffer window
    Ring_Win.Set_Resizable (Ring_Win);
    Ring_Win.Set_Callback (Ring_Win_CB'Unrestricted_Access);
    Debug_TTY.Set_Text_Size (7);
    Debug_TTY.Set_Redraw_Style (Trm.No_Redraw);
    Debug_TTY.Set_Display_Columns (400);

    Win.Show_With_Args;
    --  The "firstpage" test
    Test_Firstpage;
    return FLTK.Run;

end Terminal;
