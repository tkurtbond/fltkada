    function Handle
           (This  : in out My_Terminal;
            Event : in     FLTK.Event_Kind)
        return FLTK.Event_Outcome is
    begin
        if Event = FLTK.Keydown and This.Interactive_Cursor then
            if Ev.Last_Key = FLTK.Up_Key then
                This.Cursor_Up (1, True);
                This.Redraw;
                return FLTK.Handled;
            elsif Ev.Last_Key = FLTK.Down_Key then
                This.Cursor_Down (1, True);
                This.Redraw;
                return FLTK.Handled;
            elsif Ev.Last_Key = FLTK.Left_Key then
                This.Cursor_Left;
                This.Redraw;
                return FLTK.Handled;
            elsif Ev.Last_Key = FLTK.Right_Key then
                This.Cursor_Right;
                This.Redraw;
                return FLTK.Handled;
            end if;
        end if;
        return Trm.Terminal (This).Handle (Event);
    end Handle;


    --  The ring buffer window  --

    --  A graphic horizontal bracket, Width wide
    procedure Horiz_Bracket
           (Width : in Natural) is
    begin
        Debug_TTY.Append ("┏");
        for T in 1 .. Width - 2 loop
            Debug_TTY.Print_Char ("━");
        end loop;
        Debug_TTY.Append ("┓");
    end Horiz_Bracket;


    --  Count cells of ring row Row, each in its own style
    procedure Show_Row
           (Row   : in Natural;
            Count : in Natural) is
    begin
        for Col in 0 .. Count - 1 loop
            Debug_TTY.Set_Text_Attrib (TTY.Cell_Attributes (Row, Col));
            Debug_TTY.Set_Text_Fore_Color (TTY.Cell_Fore_Color (Row, Col));
            Debug_TTY.Set_Text_Back_Color (TTY.Cell_Back_Color (Row, Col));
            Debug_TTY.Print_Char (TTY.Cell_Text (Row, Col));
        end loop;
        Debug_TTY.Append (ESC & "[0m");  --  restore default fg/bg/attrib
    end Show_Row;


    procedure Update_Ring is
        M1, M2, M3, M4 : Integer;
        Selected : constant Boolean := TTY.Get_Selection (M1, M2, M3, M4);
        pragma Unreferenced (Selected);

        Ring_Rows : constant Natural := TTY.Ring_Rows;
        Ring_Cols : constant Natural := TTY.Ring_Columns;
        Hist_Rows : constant Natural := TTY.Get_History_Rows;
        Disp_Rows : constant Natural := TTY.Get_Display_Rows;
        Disp_Cols : constant Natural := TTY.Get_Display_Columns;
        Flags     : constant Trm.Style_Flags := TTY.Get_Style_Flags;
        Charflags : constant FLTK.Color :=
            (if Flags.Xterm_Fore then 1 else 0) + (if Flags.Xterm_Back then 2 else 0);

        X : Natural := 5;
    begin
        Debug_TTY.Append (ESC & "c");    --  reset terminal (clear screen, history, home)
        Debug_TTY.Append (ESC & "[s");   --  save cursor
        Debug_TTY.Print (Right_By (X) & " " & ESC & "[7m   Ring Index   " & ESC & "[0m" & LF);
        Debug_TTY.Print (Right_By (X) & "   ring_rows(): " & Left (Ring_Rows, 3) &
            "  Mouse Selection (srow,scol,erow,ecol)" & LF);
        Debug_TTY.Print (Right_By (X) & "   ring_cols(): " & Left (Ring_Cols, 3) &
            "            " & ESC & "[7m(" & Image (M1) & "," & Image (M2) & "," &
            Image (M3) & "," & Image (M4) & ")" & ESC & "[0m" & LF);
        Debug_TTY.Print (Right_By (X) & "      offset(): " & Left (TTY.Ring_Offset, 3) &
            "  currentstyle->charflags=" & Hex (Charflags, 2) & LF);
        Debug_TTY.Print (Right_By (X) & " ");
        Horiz_Bracket (Disp_Cols);
        Debug_TTY.Print (ESC & "[u");    --  recall cursor

        X := X + Disp_Cols + 11;
        Debug_TTY.Print (Right_By (X) & " " & ESC & "[7m   History Index   " & ESC & "[0m" & LF);
        Debug_TTY.Print (Right_By (X) & "   hist_rows(): " & Image (Hist_Rows) &
            " hist_srow()=" & Image (TTY.History_Start) & LF);
        Debug_TTY.Print (Right_By (X) & "   hist_cols(): " & Image (Ring_Cols) &
            " hist_erow()=" & Image (TTY.History_End) & LF);
        Debug_TTY.Print (Right_By (X) & "    hist_use(): " & Image (TTY.Get_History_Use) & LF);
        Debug_TTY.Print (Right_By (X) & " ");
        Horiz_Bracket (Disp_Cols);
        Debug_TTY.Append (ESC & "[u");   --  recall cursor

        X := X + Disp_Cols + 11;
        Debug_TTY.Print (Right_By (X) & " " & ESC & "[7m   Display Index   " & ESC & "[0m" & LF);
        Debug_TTY.Print (Right_By (X) & "   disp_rows(): " & Image (Disp_Rows) &
            " disp_srow()=" & Image (TTY.Display_Start) & LF);
        Debug_TTY.Print (Right_By (X) & "   disp_cols(): " & Image (Disp_Cols) &
            " disp_erow()=" & Image (TTY.Display_End) & LF);
        Debug_TTY.Append ((1 => LF));
        Debug_TTY.Print (Right_By (X) & " ");
        Horiz_Bracket (Disp_Cols);
        Debug_TTY.Append ((1 => LF));

        for Row in 0 .. Ring_Rows - 1 loop
            --  The ring
            Debug_TTY.Print (Right (Row, 3) & " R[");
            Show_Row (Row, Ring_Cols);
            Debug_TTY.Append ("]    ");
            --  The history
            if Row < Hist_Rows then
                Debug_TTY.Print (Right (Row, 3) & " H[");
                Show_Row ((TTY.History_Start + Row) mod Ring_Rows, Ring_Cols);
                Debug_TTY.Print ("]    ");
            else
                Debug_TTY.Append ("     ");
                for Col in 1 .. Ring_Cols loop
                    Debug_TTY.Append (" ");
                end loop;
                Debug_TTY.Append ("     ");
            end if;
            --  The display
            if Row < Disp_Rows then
                Debug_TTY.Print (Right (Row, 3) & " D[");
                Show_Row ((TTY.Display_Start + Row) mod Ring_Rows, Disp_Cols);
                Debug_TTY.Append ("]" & ESC & "[K" & LF);
            else
                Debug_TTY.Append (ESC & "[K" & LF);
            end if;
        end loop;
        Debug_TTY.Print ("--- END" & ESC & "[0J" & LF);  --  clear eos
    end Update_Ring;


    procedure Ring_Timer is
    begin
        Update_Ring;
        --  Redraw after all changes have been made
        Ring_Win.Redraw;
        FLTK.Static.Repeat_Timeout (0.10, Ring_Timer'Unrestricted_Access);
    end Ring_Timer;


