    procedure Margins_CB
           (Item : in out FLTK.Widgets.Widget'Class)
    is
        pragma Unreferenced (Item);
        Text   : constant String := Margins.Get_Value;
        From   : Positive := Text'First;
        Values : array (1 .. 4) of Integer;
        Value  : Long_Long_Integer;
        Found  : Boolean;
    begin
        for I in Values'Range loop
            Scan_Number (Text, From, 10, Value, Found);
            if Found and I < Values'Last then
                Found := From <= Text'Last and then Text (From) = ',';
                From := From + 1;
            end if;
            if not Found then
                FLTK.Asks.Alert ("Margins: expected four comma separated integers");
                return;
            end if;
            Values (I) := Integer (Value - (if Value >= 2**31 then 2**32 else 0));
        end loop;
        TTY.Set_Margin_Left (Values (1));
        TTY.Set_Margin_Right (Values (2));
        TTY.Set_Margin_Top (Values (3));
        TTY.Set_Margin_Bottom (Values (4));
        TTY.Redraw;
    end Margins_CB;


