    --  Output  --

    --  Appends Text to the terminal, and to stdout if Stdout is on
    procedure Append_TTY
           (Text : in String) is
    begin
        TTY.Append (Text);
        if Stdout.Is_On then
            declare
                Written : constant Integer :=
                    OS.Write (OS.Standout, Text'Address, Text'Length);
                pragma Unreferenced (Written);
            begin
                null;
            end;
        end if;
    end Append_TTY;


    --  If the cursor is floating, a line feed first
    procedure New_Line_If_Floating is
    begin
        if TTY.Get_Cursor_Column /= 0 then
            TTY.Append ((1 => LF));
        end if;
    end New_Line_If_Floating;


    --  The self tests  --

    --  The next element of each test to show
    Indexes : array (TT.Tests'Range) of Positive := (others => 1);

    --  Shows test Number from its next element on, as far as an element
    --  starting "--->".  Returns 0 to be called again for the test's next
    --  page, 1 when the test has shown its last page.
    function Show_Test
           (Number : in Positive)
        return Natural
    is
        Test  : TT.Test renames TT.Tests (Number).all;
        Index : Positive renames Indexes (Number);
    begin
        while Index <= Test'Last loop
            Append_TTY (Test (Index).all);
            Index := Index + 1;
            if Ada.Strings.Fixed.Head (Test (Index - 1).all, 4) = "--->" then
                if Index > Test'Last then
                    Index := 1;
                    return 1;  --  rewind, move on to the next test
                else
                    return 0;  --  call again for this test's next page
                end if;
            end if;
        end loop;
        Index := 1;
        return 1;
    end Show_Test;


    procedure Test_Firstpage is
        Unused : constant Natural := Show_Test (1);
        pragma Unreferenced (Unused);
    begin
        null;
    end Test_Firstpage;


    Test_Ret : Natural := 1;  --  last test's return value
    Test_Num : Integer := 0;  --  the test shown last, from 0

    --  Advances (Direction 1) or reverses (-1) through the tests
    procedure Next_Escape_Test
           (Direction : in Integer) is
    begin
        Test_Num := Test_Num + Direction * Test_Ret;  --  only if the last isn't to be recalled
        if Test_Num >= TT.Tests'Length then
            Test_Num := 0;
        end if;
        if Test_Num < 0 then
            Test_Num := TT.Tests'Length - 1;
        end if;
        Test_Ret := Show_Test (Test_Num + 1);
        TTY.Redraw;
    end Next_Escape_Test;


    --  rand () from C, as terminal.cxx's speed test uses it
    function Rand
        return Interfaces.C.int;
    pragma Import (C, Rand, "rand");


    --  50 passes of random characters over the whole screen (no scrolling)
    procedure Speed_Test is
        Rows, Cols : Natural;
    begin
        --  First switch redraw style to none, so we can handle redraws
        TTY.Set_Redraw_Style (Trm.No_Redraw);
        TTY.Append (ESC & "[H");  --  home
        Rows := TTY.Get_Display_Rows;
        Cols := TTY.Get_Display_Columns;
        for I in 1 .. 50 loop
            for Row in 0 .. Rows - 1 loop
                for Col in 0 .. Cols - 1 loop
                    declare
                        C : constant Character :=
                            Character'Val (Character'Pos (' ') + Integer (Rand mod 16#50#));
                    begin
                        TTY.Set_Text_Fore_Color_Xterm (Trm.Xterm_Color (Rand mod 8));
                        TTY.Plot_Char (C, Row, Col);
                    end;
                end loop;
            end loop;
            TTY.Redraw;
            declare
                Unused : constant Long_Float := FLTK.Wait (0.005);
                pragma Unreferenced (Unused);
            begin
                null;
            end;
        end loop;
        --  leave test with white on black
        TTY.Append (ESC & "[c");  --  reset terminal
        --  back to rate limited
        TTY.Set_Redraw_Style (Trm.Rate_Limited);
        --  Show the Unicode alignment page
        Test_Firstpage;
    end Speed_Test;


    --  Colour bars, ECR-1-1978, set with the API, not escape codes
    procedure Show_Colorbars is
        type Colors is array (Positive range <>) of FLTK.Color;
        --       grey          yellow        cyan          green
        --       magenta       red           blue
        Bars1 : constant Colors :=
           (16#c0c0c000#, 16#bfc03700#, 16#2ac0bf00#, 16#25c03300#,
            16#be00bb00#, 16#bd051800#, 16#1600ba00#);
        Bars2 : constant Colors :=
           (16#1600ba00#, 16#11111100#, 16#be00bb00#, 16#11111100#,
            16#2ac0bf00#, 16#11111100#, 16#c0c0c000#);
        --       -I            100% wht      Q+
        --       superblack    black         4% black     (pluge)
        Boxes : constant Colors :=
           (16#05214a00#, 16#ffffff00#, 16#32006700#, 16#11111100#,
            16#03030300#, 16#11111100#, 16#1d1d1d00#, 16#11111100#);

        function Blocks
               (Count : in Natural)
            return String
        is
            Result : String (1 .. 3 * Count);
        begin
            for I in 0 .. Count - 1 loop
                Result (3 * I + 1 .. 3 * I + 3) := "█";
            end loop;
            return Result;
        end Blocks;

        Bar   : constant String := Blocks (11);
        Box1  : constant String := Blocks (14);
        Box2  : constant String := Blocks (13);
        Pluge : constant String := Blocks (3);

        Fg_Save : constant FLTK.Color := TTY.Get_Text_Fore_Color;
        Bg_Save : constant FLTK.Color := TTY.Get_Text_Back_Color;
    begin
        New_Line_If_Floating;
        TTY.Append (ESC & "[2J" & ESC & "[H");
        --  75% bars
        for Y in 1 .. 16 loop
            for C of Bars1 loop
                TTY.Set_Text_Fore_Color (C);
                TTY.Append (Bar);
            end loop;
            TTY.Append ((1 => LF));
        end loop;
        --  Strip
        for Y in 1 .. 2 loop
            for C of Bars2 loop
                TTY.Set_Text_Fore_Color (C);
                TTY.Append (Bar);
            end loop;
            TTY.Append ((1 => LF));
        end loop;
        --  Bottom boxes
        for Y in 0 .. 6 loop
            for I in Boxes'Range loop
                TTY.Set_Text_Fore_Color (Boxes (I));
                if I <= 3 then
                    TTY.Append (Box1);
                elsif I <= 4 then
                    TTY.Append (Box2);
                elsif I <= 7 then
                    TTY.Append (Pluge);
                else
                    TTY.Append (Box2);
                end if;
            end loop;
            if Y < 6 then
                TTY.Append ((1 => LF));
            end if;
        end loop;
        --  Restore fg/bg colors
        TTY.Set_Text_Fore_Color (Fg_Save);
        TTY.Set_Text_Back_Color (Bg_Save);
    end Show_Colorbars;


    --  Count more test lines
    procedure Add_Lines
           (Count : in Natural) is
    begin
        New_Line_If_Floating;
