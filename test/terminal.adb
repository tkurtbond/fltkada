    --  Formatting, as terminal.cxx's printf does it  --

    --  "%d"
    function Image
           (Value : in Integer)
        return String is
    begin
        return Ada.Strings.Fixed.Trim (Integer'Image (Value), Ada.Strings.Left);
    end Image;

    --  "%-Nd"
    function Left
           (Value : in Integer;
            Width : in Natural)
        return String
    is
        S : constant String := Image (Value);
    begin
        return S & (1 .. Width - Natural'Min (Width, S'Length) => ' ');
    end Left;

    --  "%Nd", or "%0Nd" with Fill '0'
    function Right
           (Value : in Natural;
            Width : in Natural;
            Fill  : in Character := ' ')
        return String
    is
        S : constant String := Image (Value);
    begin
        return (1 .. Width - Natural'Min (Width, S'Length) => Fill) & S;
    end Right;

    --  "%0Nx"
    function Hex
           (Value : in FLTK.Color;
            Width : in Positive)
        return String
    is
        Digit  : constant String := "0123456789abcdef";
        Result : String (1 .. 8);
        First  : Positive := Result'Last + 1;
        V      : FLTK.Color := Value;
    begin
        loop
            First := First - 1;
            Result (First) := Digit (Natural (V mod 16) + 1);
            V := V / 16;
            exit when V = 0 and Result'Last - First + 1 >= Width;
        end loop;
        return Result (First .. Result'Last);
    end Hex;

    --  "ESC[NC": the cursor N columns right
    function Right_By
           (Count : in Natural)
        return String is
    begin
        return ESC & "[" & Image (Count) & "C";
    end Right_By;


