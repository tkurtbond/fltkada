    --  Appends the file Name, or why it can't be read
    procedure Show_File_Contents
           (Name : in String)
    is
        FD : OS.File_Descriptor;
        Buffer : String (1 .. 1022);
        Count  : Integer;
    begin
        New_Line_If_Floating;
        FD := OS.Open_Read (Name, OS.Binary);
        if FD = OS.Invalid_FD then
            TTY.Append_UTF8 (ESC & "[1;31m" & Name & ": " & OS.Errno_Message & ESC & "[0m" & LF);
            return;
        end if;
