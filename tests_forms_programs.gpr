--  Released into the public domain


--  The Forms library's demo programs, in test/forms, built only with that
--  library (fltkada_forms.gpr), into bin with the other programs, where
--  make smoke runs them.


with

    "fltkada_forms",
    "proj/common";


project Tests_Forms_Programs is


    for Languages use ("Ada");

    for Source_Dirs use ("test/forms");
    for Object_Dir  use "obj/forms_programs";
    for Exec_Dir    use "bin";

    for Main use
       ("forms.adb",
        "free_form.adb");

    package Builder is
        for Executable ("forms.adb")     use "forms";
        for Executable ("free_form.adb") use "free_form";

        for Default_Switches ("Ada") use
            Common.Builder'Default_Switches ("Ada");
        for Global_Compilation_Switches ("Ada") use
            Common.Builder'Global_Compilation_Switches ("Ada");
    end Builder;

    package Compiler       renames Common.Compiler;
    package Binder         renames Common.Binder;
    package Linker         renames Common.Linker;
    package Pretty_Printer renames Common.Pretty_Printer;


end Tests_Forms_Programs;
