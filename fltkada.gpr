

with

    "proj/common";


library project FLTKAda is


    type Library_Kind_Type is ("static", "dynamic");
    Kind : Library_Kind_Type := external ("library_type", "dynamic");


    for Languages use ("Ada", "C++");

    for Source_Dirs  use ("body", "spec");
    --  A directory of each for each kind: the dynamic library's objects are
    --  position-independent and the static one's aren't, so built in one
    --  directory, the second kind would reuse the first's objects (a
    --  dynamic link after a static build fails: "recompile with -fPIC").
    for Object_Dir   use "obj/" & Kind;
    for Library_Dir  use "lib/" & Kind;
    for Library_Name use "fltkada";
    for Library_Kind use Kind;

    --  The FLTK libraries the C++ shims call.  fltk.ads names them with
    --  pragma Linker_Options, but that reaches only a program whose closure
    --  includes FLTK; Linker_Options here reaches every program that withs
    --  this project, installed or not, static or dynamic.  Library_Options
    --  records them in libfltkada.so itself (NEEDED), so the shared library
    --  resolves its own symbols.
    FLTK_Libraries := ("-lfltk", "-lfltk_images", "-lfltk_gl");

    case Kind is
        when "dynamic" =>
            for Library_Options use FLTK_Libraries;
        when "static" =>
            null;
    end case;

    package Builder        renames Common.Builder;
    package Compiler       renames Common.Compiler;
    package Binder         renames Common.Binder;
    package Pretty_Printer renames Common.Pretty_Printer;

    package Linker is
        for Linker_Options use FLTK_Libraries;
    end Linker;


end FLTKAda;


