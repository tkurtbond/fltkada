--  Ada port of FLTK's examples/shapedwindow.cxx: a window shaped like a
--  ring, with a tiled background, that can be dragged around by its body
--  and shrunk or enlarged.
--
--  The tiled background comes from FLTK's test/pixmaps/tile.xpm, copied in
--  below.  The original deletes its window and images at the end to show
--  it leaks nothing; here they are finalized when Shapedwindow returns.


with

    Ada.Strings.Unbounded,
    FLTK.Devices.Surface.Image,
    FLTK.Draw,
    FLTK.Events,
    FLTK.Images.Pixmaps,
    FLTK.Images.RGB,
    FLTK.Images.Tiled,
    FLTK.Widgets.Boxes,
    FLTK.Widgets.Buttons,
    FLTK.Widgets.Groups.Windows.Double;

use type

    FLTK.Event_Kind;


function Shapedwindow
    return Integer
is


    package SU  renames Ada.Strings.Unbounded;

    function "+" (Str : in String) return SU.Unbounded_String renames SU.To_Unbounded_String;

    package Surf renames FLTK.Devices.Surface;
    package Img  renames FLTK.Devices.Surface.Image;
    package Pix  renames FLTK.Images.Pixmaps;
    package RGB  renames FLTK.Images.RGB;
    package Tl   renames FLTK.Images.Tiled;
    package Bx   renames FLTK.Widgets.Boxes;
    package Btn  renames FLTK.Widgets.Buttons;
    package Grp  renames FLTK.Widgets.Groups;
    package DW   renames FLTK.Widgets.Groups.Windows.Double;


    --  test/pixmaps/tile.xpm

    type Tile_Pixel_Rows is array (1 .. 100) of String (1 .. 100);

    function To_Data
           (Rows : in Tile_Pixel_Rows)
        return Pix.Pixmap_Data
    is
        Data : Pix.Pixmap_Data (Rows'Range, Rows (Rows'First)'Range);
    begin
        for R in Data'Range (1) loop
            for C in Data'Range (2) loop
                Data (R, C) := Rows (R) (C);
            end loop;
        end loop;
        return Data;
    end To_Data;

