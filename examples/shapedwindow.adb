    procedure CB
           (Item : in out FLTK.Widgets.Widget'Class) is
    begin
        Item.Nearest_Window.Hide;
    end CB;


    type Drag_Box is new Bx.Box with null record;

    overriding function Handle
           (This  : in out Drag_Box;
            Event : in     FLTK.Event_Kind)
        return FLTK.Event_Outcome;


    From_X, From_Y, Win_X, Win_Y : Integer := 0;

    overriding function Handle
           (This  : in out Drag_Box;
            Event : in     FLTK.Event_Kind)
        return FLTK.Event_Outcome is
    begin
        if Event = FLTK.Push then
            From_X := FLTK.Events.Mouse_X_Root;
            From_Y := FLTK.Events.Mouse_Y_Root;
            Win_X  := This.Nearest_Window.Get_X_Root;
            Win_Y  := This.Nearest_Window.Get_Y_Root;
            return FLTK.Handled;
        elsif Event = FLTK.Drag then
            declare
                Delta_X : constant Integer := FLTK.Events.Mouse_X_Root - From_X;
                Delta_Y : constant Integer := FLTK.Events.Mouse_Y_Root - From_Y;
            begin
                This.Nearest_Window.Reposition (Win_X + Delta_X, Win_Y + Delta_Y);
                return FLTK.Handled;
            end;
        end if;
        return Bx.Box (This).Handle (Event);
    end Handle;


    Factor : constant Float := 1.3;

    Dim : constant Integer := 200;


    type Button_Access is access Btn.Button;

    Shrink_Button : Button_Access;


    procedure Shrink
           (Item : in out FLTK.Widgets.Widget'Class)
    is
        Win : constant access FLTK.Widgets.Groups.Windows.Window'Class := Item.Nearest_Window;
        Old : constant Integer := Win.Get_W;
    begin
        Win.Resize (Integer (Float'Truncation (Float (Old) / Factor)),
                    Integer (Float'Truncation (Float (Old) / Factor)));
        if Win.Get_W <= Dim then
            Item.Deactivate;
        end if;
    end Shrink;


    procedure Enlarge
           (Item : in out FLTK.Widgets.Widget'Class)
    is
        Win : constant access FLTK.Widgets.Groups.Windows.Window'Class := Item.Nearest_Window;
        Old : constant Integer := Win.Get_W;
    begin
        Win.Resize (Integer (Float'Truncation (Float (Old) * Factor)),
                    Integer (Float'Truncation (Float (Old) * Factor)));
        Shrink_Button.Activate;
    end Enlarge;


    function Prepare_Shape
           (W : in Integer)
        return RGB.RGB_Image
    is
        --  draw a white circle with a hole in it on black background
        Surface : Img.Image_Surface := Img.Forge.Create (W, W);
    begin
        Surf.Push_Current (Surface);
        FLTK.Draw.Set_Color (FLTK.Black_Color);
        FLTK.Draw.Rect_Fill (-1, -1, W + 2, W + 2);
        FLTK.Draw.Set_Color (FLTK.White_Color);
        FLTK.Draw.Pie (2, 2, W - 4, W - 4, 0.0, 360.0);
        FLTK.Draw.Set_Color (FLTK.Black_Color);
        FLTK.Draw.Pie (Integer (Long_Float'Truncation (0.7 * Long_Float (W))), W / 2,
                       W / 4, W / 4, 0.0, 360.0);
        return Result : constant RGB.RGB_Image := Surface.Get_Image do
            Surf.Pop_Current;
        end return;   --  return white image on black background
    end Prepare_Shape;


    Win : DW.Double_Window := DW.Forge.Create (100, 100, Dim, Dim, "Testing1");

    Shape : constant RGB.RGB_Image := Prepare_Shape (Dim);

    Win_W : constant Integer := Win.Get_W;
    Win_H : constant Integer := Win.Get_H;

    Box : Drag_Box := (Bx.Forge.Create (Win, 0, 0, Win_W, Win_H) with null record);

    Pxm  : Pix.Pixmap := Pix.Forge.Create (Tile_Header, Tile_Colors, To_Data (Tile_Rows));
    Tile : Tl.Tiled_Image := Tl.Forge.Create (Pxm);

    G1 : Grp.Group := Grp.Forge.Create (Win, 10, 20, 80, 20);
    B  : Btn.Button := Btn.Forge.Create (G1, 10, 20, 80, 20, "Close");

    G2 : Grp.Group := Grp.Forge.Create (Win, 60, 70, 80, 40, "Drag me");
    BS : constant Button_Access := new Btn.Button'(Btn.Forge.Create (G2, 60, 70, 80, 20, "Shrink"));
    BE : Btn.Button := Btn.Forge.Create (G2, 60, 90, 80, 20, "Enlarge");


begin


    Win.Shape (Shape);
    Box.Set_Image (Tile);

    G1.Set_Box (FLTK.No_Box);
    B.Set_Callback (CB'Unrestricted_Access);
    G1.End_Current;
    G1.Clear_Resizable;

    G2.Set_Box (FLTK.No_Box);
    G2.Set_Alignment (FLTK.Align_Top);
    Shrink_Button := BS;
    BS.Set_Callback (Shrink'Unrestricted_Access);
    BS.Deactivate;
    BE.Set_Callback (Enlarge'Unrestricted_Access);
    G2.End_Current;
    G2.Clear_Resizable;

    Win.End_Current;
    Win.Set_Resizable (Win);
    Win.Show_With_Args;
    return FLTK.Run;


end Shapedwindow;
